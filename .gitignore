# 📦 Dependencies folder (Never upload this, it's recreated with 'npm install')
node_modules/

# 🔑 Private environment credentials (Contains your MongoDB Atlas password)
.env

# 🍏 System specific files (Hidden macOS and operating system metadata)
.DS_Store
Thumbs.db

# 📋 Application runtime logs and error captures
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 🛡️ IDE configurations (Local settings for VS Code or text editors)
.vscode/
.idea/
